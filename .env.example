# Copy this file to `.env` (which is gitignored) and fill in the values.
#
# WANDB_API_KEY and HF_TOKEN are consumed by scripts/00_setup_runpod.sh
# on the pod; they also need to be pasted into RunPod's Environment
# Variables UI when deploying.
#
# RUNPOD_API_KEY is only used locally (e.g. with `runpodctl` or the
# RunPod REST API) to manage pods from your laptop; it is never read on
# the pod itself.

WANDB_API_KEY=wandb_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RUNPOD_API_KEY=rpa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
